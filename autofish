                local clickedThisCircle = false

                while isFishing do
                    local fishingGui = playerGui:FindFirstChild("FishingGui")
                    if fishingGui and fishingGui.Enabled then
                        local fishing = fishingGui:FindFirstChild("Fishing")
                        if fishing and fishing.Visible then
                            local btn = fishing:FindFirstChild("ClickSpeedUpActive") or fishing:FindFirstChild("ClickSpeedUp")

                            if btn and btn.Visible and btn.AbsoluteSize.X > 10 then
                                local curPos = btn.AbsolutePosition

                                if (curPos - lastTargetPos).Magnitude > 30 then
                                    lastTargetPos = curPos
                                    currentSpawnTime = tick()
                                    clickedThisCircle = false
                                end

                                local circleAge = tick() - currentSpawnTime
                                if not clickedThisCircle and circleAge >= 0.28 then
