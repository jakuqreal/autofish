-- 2. Funkcja realizująca kliknięcie w podany element GUI
local function clickTarget(guiObj)
    local absPos = guiObj.AbsolutePosition
    local absSize = guiObj.AbsoluteSize
    local centerX = absPos.X + (absSize.X / 2)
    local centerY = absPos.Y + (absSize.Y / 2)

    -- Bufor stabilizujący przed kliknięciem
    task.wait(0.09)

    -- Próba wywołania sygnałów przycisku, jeśli to Button
    pcall(function()
        if guiObj:IsA("GuiButton") and getconnections then
            for _, conn in pairs(getconnections(guiObj.MouseButton1Click)) do conn:Fire() end
            for _, conn in pairs(getconnections(guiObj.Activated)) do conn:Fire() end
        end
    end)

    -- Kliknięcie wirtualną myszką w środek obiektu
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
    end)
end

-- 3. Logika wyszukiwania właściwego celu wewnątrz MainFrame gry
local function resolveTarget(mainFrameGame)
    -- Sprawdzamy czy wewnątrz MainFrame gry znajduje się klikalny przycisk lub kółko
    for _, child in ipairs(mainFrameGame:GetChildren()) do
        if child:IsA("GuiObject") and child.Visible and child.AbsoluteSize.X > 10 then
            return child
        end
    end
    -- Jeśli nie ma potomków, celem jest sam MainFrame
    return mainFrameGame
end

-- 4. Pętla bota
local isRunning = false
local loopThread = nil

local function setBotState(active)
    isRunning = active
    if isRunning then
        statusLabel.Text = "● STATUS: AKTYWNY"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 194)
        toggleButton.Text = "ZATRZYMAJ"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 56, 92)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        loopThread = task.spawn(function()
            while isRunning do
                -- Ścieżka gry: playerGui.AutoFishGui.MainFrame
                local gameGui = playerGui:FindFirstChild("AutoFishGui")
                if gameGui and gameGui.Enabled then
                    local mainFrameGame = gameGui:FindFirstChild("MainFrame")

                    if mainFrameGame and mainFrameGame.Visible and mainFrameGame.AbsoluteSize.X > 0 then
                        local target = resolveTarget(mainFrameGame)
                        clickTarget(target)

                        -- Przerwa na rejestrację uderzenia przez grę (cooldown)
                        task.wait(0.48)
                    end
                end

                task.wait(0.02)
            end
        end)
    else
        statusLabel.Text = "● STATUS: WYŁĄCZONY"
        statusLabel.TextColor3 = Color3.fromRGB(255, 75, 114)
        toggleButton.Text = "URUCHOM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 201, 232)
        toggleButton.TextColor3 = Color3.fromRGB(5, 16, 26)

        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setBotState(not isRunning)
end)

