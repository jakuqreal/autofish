local function checkLicenseOnline(key)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then
        return false, (currentLang == "PL") and "Brak obsługi HTTP w executorze" or "Executor lacks HTTP request function"
    end

    local success, response = pcall(function()
        return req({
            Url = AUTH_URL .. HttpService:UrlEncode(key),
            Method = "GET"
        })
    end)

    if not success or not response then
        return false, (currentLang == "PL") and "Błąd połączenia z serwerem licencji" or "Connection error to license server"
    end

    if response.StatusCode == 200 then
        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if decodeSuccess and data and data.valid then
            return true, data.user or "Authorized User"
        end
    end

    return false, (currentLang == "PL") and "Nieprawidłowy lub wygasły klucz" or "Invalid or Expired License Key"
end

