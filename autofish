-- 6. Logika działania i pętli
local isRunning = false
local loopThread = nil

local function setBotState(active)
    isRunning = active
    if isRunning then
        statusLabel.Text = "● STATUS: AKTYWNY"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 194)
        toggleButton.Text = "ZATRZYMAJ"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 56, 92)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        -- Uruchomienie wątku pracy
        loopThread = task.spawn(function()
            while isRunning do
                -- Tutaj następuje akcja gry (np. wykrywanie elementu w PlayerGui / workspace)
                -- task.wait zapobiega przegrzaniu procesora i freeze'om gry:
                task.wait(0.48) -- Czas dostosowany do bezpiecznego debouce minigry
            end
        end)
    else
        statusLabel.Text = "● STATUS: WYŁĄCZONY"
        statusLabel.TextColor3 = Color3.fromRGB(255, 75, 114)
        toggleButton.Text = "URUCHOM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 201, 232)
        toggleButton.TextColor3 = Color3.fromRGB(5, 16, 26)

        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setBotState(not isRunning)
end)

