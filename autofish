-- 2. Funkcja klikająca bezpośrednio w ClickSpeedUp
local function clickButton(button)
    local absPos = button.AbsolutePosition
    local absSize = button.AbsoluteSize
    local centerX = absPos.X + (absSize.X / 2)
    local centerY = absPos.Y + (absSize.Y / 2)

    -- Bufor stabilizujący (chroni przed falstartem / anty-spamem gry)
    task.wait(0.08)

    -- Sposób 1: Bezpośrednie wywołanie połączeń przycisku
    pcall(function()
        if getconnections then
            for _, conn in pairs(getconnections(button.MouseButton1Click)) do conn:Fire() end
            for _, conn in pairs(getconnections(button.Activated)) do conn:Fire() end
        end
    end)

    -- Sposób 2: Kliknięcie wirtualną myszką (VirtualInputManager) w środek przycisku
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
    end)
end

-- 3. Pętla bota
local isRunning = false
local loopThread = nil

local function setBotState(active)
    isRunning = active
    if isRunning then
        statusLabel.Text = "● STATUS: AKTYWNY"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 194)
        toggleButton.Text = "ZATRZYMAJ"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 56, 92)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        loopThread = task.spawn(function()
            while isRunning do
                -- Wyszukiwanie dokładnej ścieżki w PlayerGui
                local fishingGui = playerGui:FindFirstChild("FishingGui")
                if fishingGui and fishingGui.Enabled then
                    local fishingFrame = fishingGui:FindFirstChild("Fishing")
                    if fishingFrame and fishingFrame.Visible then
                        local btn = fishingFrame:FindFirstChild("ClickSpeedUp")
                        
                        -- Sprawdzamy czy przycisk istnieje, jest widoczny i ma rozmiar
                        if btn and btn:IsA("ImageButton") and btn.Visible and btn.AbsoluteSize.X > 0 then
                            clickButton(btn)
                            -- Cooldown na animację zaliczenia trafienia
                            task.wait(0.46)
                        end
                    end
                end

                task.wait(0.02)
            end
        end)
    else
        statusLabel.Text = "● STATUS: WYŁĄCZONY"
        statusLabel.TextColor3 = Color3.fromRGB(255, 75, 114)
        toggleButton.Text = "URUCHOM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 201, 232)
        toggleButton.TextColor3 = Color3.fromRGB(5, 16, 26)

        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setBotState(not isRunning)
end)

