-- 2. Funkcja przeliczająca pozycję BillboardGui i wykonująca kliknięcie
local function clickFishTarget(billboard, button)
    -- Bezpieczny bufor wejścia (ochrona przed anty-spamem/falstartem gry)
    task.wait(0.08)

    -- A. Bezpośrednie wywołanie eventów przycisku w silniku gry
    if button and getconnections then
        pcall(function()
            for _, conn in pairs(getconnections(button.MouseButton1Click)) do conn:Fire() end
            for _, conn in pairs(getconnections(button.Activated)) do conn:Fire() end
            for _, conn in pairs(getconnections(button.MouseButton1Down)) do conn:Fire() end
            for _, conn in pairs(getconnections(button.MouseButton1Up)) do conn:Fire() end
        end)
    end

    -- B. Wyliczenie współrzędnych ekranu dla wirtualnego kliknięcia myszką
    local screenX, screenY = nil, nil

    if button and button.AbsolutePosition.X > 0 and button.AbsolutePosition.Y > 0 then
        screenX = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
        screenY = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2)
    else
        -- Przeliczenie ze współrzędnych 3D (Adornee w Workspace)
        local adornee = billboard.Adornee or (billboard.Parent:IsA("BasePart") and billboard.Parent)
        if adornee and adornee:IsA("BasePart") then
            local pos, onScreen = camera:WorldToViewportPoint(adornee.Position + billboard.ExtentsOffsetWorld)
            if onScreen then
                screenX, screenY = pos.X, pos.Y
            end
        end
    end

    -- C. Symulacja kliknięcia przez VirtualInputManager
    if screenX and screenY then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(screenX, screenY, 0, true, game, 1)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(screenX, screenY, 0, false, game, 1)
        end)
    end
end

-- 3. Główna pętla bota
local isRunning = false
local loopThread = nil

local function setBotState(active)
    isRunning = active
    if isRunning then
        statusLabel.Text = "● STATUS: AKTYWNY"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 194)
        toggleButton.Text = "ZATRZYMAJ"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 56, 92)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        loopThread = task.spawn(function()
            while isRunning do
                -- Dokładna ścieżka z Twojego pliku: PlayerGui.FishingView.FishClick
                local fishingView = playerGui:FindFirstChild("FishingView")
                if fishingView then
                    local fishClick = fishingView:FindFirstChild("FishClick")
                    
                    if fishClick and fishClick.Enabled then
                        local buyBtn = fishClick:FindFirstChild("Buy")
                        -- Jeśli przycisk istnieje i jest widoczny
                        if buyBtn and buyBtn.Visible then
                            clickFishTarget(fishClick, buyBtn)
                            -- Przerwa na zaliczenie trafienia przez grę (cooldown anty-spamowy)
                            task.wait(0.48)
                        end
                    end
                end

                task.wait(0.015)
            end
        end)
    else
        statusLabel.Text = "● STATUS: WYŁĄCZONY"
        statusLabel.TextColor3 = Color3.fromRGB(255, 75, 114)
        toggleButton.Text = "URUCHOM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 201, 232)
        toggleButton.TextColor3 = Color3.fromRGB(5, 16, 26)

        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setBotState(not isRunning)
end)

