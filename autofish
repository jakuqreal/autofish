local function clickGuiElement(target)
    -- Pobieramy środek przycisku na ekranie
    local pos = target.AbsolutePosition
    local size = target.AbsoluteSize
    local centerX = pos.X + (size.X / 2)
    local centerY = pos.Y + (size.Y / 2)

    task.wait(0.08)

    pcall(function()
        if target:IsA("GuiButton") then
            for _, conn in pairs(getconnections(target.MouseButton1Click)) do
                conn:Fire()
            end
            for _, conn in pairs(getconnections(target.Activated)) do
                conn:Fire()
            end
        end
    end)

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
    end)
end

local function isCircleTarget(obj)
    if obj:IsA("GuiObject") and obj.Visible and obj.AbsoluteSize.X > 15 and obj.AbsoluteSize.Y > 15 then
        -- Omijamy elementy naszego własnego menu
        if obj:IsDescendantOf(screenGui) then 
            return false 
        end

        local nameLower = obj.Name:lower()
        if nameLower:find("circle") or nameLower:find("target") or nameLower:find("ring") or nameLower:find("hit") or nameLower:find("fish") then
            return true
        end

        local cornerChild = obj:FindFirstChildOfClass("UICorner")
        if cornerChild and (cornerChild.CornerRadius.Scale >= 0.5 or cornerChild.CornerRadius.Offset >= 20) then
            return true
        end
    end
    return false
end

local isRunning = false
local loopThread = nil

local function setBotState(active)
    isRunning = active
    if isRunning then
        statusLabel.Text = "● STATUS: AKTYWNY"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 194)
        toggleButton.Text = "ZATRZYMAJ"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 56, 92)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        loopThread = task.spawn(function()
            while isRunning do
                local clickedAny = false

                -- Przeszukujemy interfejsy gracza
                for _, gui in ipairs(playerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.Enabled and gui ~= screenGui then
                        for _, element in ipairs(gui:GetDescendants()) do
                            if isCircleTarget(element) then
                                clickGuiElement(element)
                                clickedAny = true
                                -- Zabezpieczenie anty-spamowe: pauza po udanym kliknięciu
                                task.wait(0.40)
                                break
                            end
                        end
                    end
                    if clickedAny then break end
                end

                task.wait(0.02)
            end
        end)
    else
        statusLabel.Text = "● STATUS: WYŁĄCZONY"
        statusLabel.TextColor3 = Color3.fromRGB(255, 75, 114)
        toggleButton.Text = "URUCHOM"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 201, 232)
        toggleButton.TextColor3 = Color3.fromRGB(5, 16, 26)

        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setBotState(not isRunning)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.RightShift then
