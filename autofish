-- 2. Sprawdzanie czy minigra nie nałożyła pauzy StreakPaused
local function isCooldownActive(fishing)
    local cooldownBar = fishing:FindFirstChild("CooldownBar")
    if cooldownBar then
        local streakPaused = cooldownBar:FindFirstChild("StreakPaused")
        if streakPaused and streakPaused.Visible and streakPaused.TextTransparency < 0.7 then
            return true
        end
    end
    return false
end

-- 3. Zmienne sterujące i funkcja kliknięcia
local isRunning = false
local loopThread = nil
local isClicking = false

local function performOptimizedClick(btn, fishing)
    if isClicking then return end
    isClicking = true

    -- Zoptymalizowany czas reakcji (z 0.28s do 0.16s)
    task.wait(0.16)

    -- Czekamy maksymalnie 0.3s jeśli gra nałożyła pauzę
    local waitCount = 0
    while isCooldownActive(fishing) and btn.Visible and waitCount < 6 do
        task.wait(0.05)
        waitCount = waitCount + 1
    end

    if isRunning and btn.Visible and btn.AbsolutePosition.X > 0 then
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local centerX = pos.X + (size.X / 2)
        local centerY = pos.Y + (size.Y / 2)

        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
    end

    -- Odstęp zabezpieczający przed podwójnym zaliczeniem
    task.wait(0.35)
    isClicking = false
end

-- 4. Funkcja włączania / wyłączania z pełnym resetem blokad
local function setBotState(active)
    isRunning = active
    isClicking = false -- Gwarancja braku zacięcia po restarcie

    if isRunning then
        statusLabel.Text = "STATUS: AKTYWNY (SYNCHRONIZACJA)"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 194)
        statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 194)
        statusStroke.Color = Color3.fromRGB(0, 255, 194)

        toggleButton.Text = "ZATRZYMAJ BOTA"
        toggleButton.BackgroundColor3 = Color3.fromRGB(244, 63, 94)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        loopThread = task.spawn(function()
            local lastHandledPos = Vector2.new(-9999, -9999)
            local lastHitTimestamp = 0

            while isRunning do
                local fishingGui = playerGui:FindFirstChild("FishingGui")
                if fishingGui and fishingGui.Enabled then
                    local fishing = fishingGui:FindFirstChild("Fishing")
                    if fishing and fishing.Visible then
                        local btn = fishing:FindFirstChild("ClickSpeedUpActive") or fishing:FindFirstChild("ClickSpeedUp")

                        if btn and btn:IsA("ImageButton") and btn.Visible and btn.AbsoluteSize.X > 10 then
                            local currentPos = btn.AbsolutePosition
                            local distance = (currentPos - lastHandledPos).Magnitude
                            local timeSinceLast = tick() - lastHitTimestamp

                            -- Minimalny czas 0.82s - najszybszy możliwy bez wywoływania StreakPaused
                            if (distance > 60 and timeSinceLast > 0.82) or (timeSinceLast > 1.15) then
                                lastHandledPos = currentPos
                                lastHitTimestamp = tick()
                                performOptimizedClick(btn, fishing)
                            end
                        else
                            lastHandledPos = Vector2.new(-9999, -9999)
                        end
                    else
                        lastHandledPos = Vector2.new(-9999, -9999)
                    end
                else
                    lastHandledPos = Vector2.new(-9999, -9999)
                end

                task.wait(0.015)
            end
        end)
    else
        statusLabel.Text = "STATUS: WYŁĄCZONY"
        statusLabel.TextColor3 = Color3.fromRGB(244, 63, 94)
        statusDot.BackgroundColor3 = Color3.fromRGB(244, 63, 94)
        statusStroke.Color = Color3.fromRGB(244, 63, 94)

        toggleButton.Text = "URUCHOM BOTA"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 201, 232)
        toggleButton.TextColor3 = Color3.fromRGB(6, 16, 26)

        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setBotState(not isRunning)
end)

